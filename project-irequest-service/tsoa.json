{
    "entryFile": "src/server.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/controllers/*.ts"
    ],
    "spec": {
        "outputDirectory": "src",
        "specVersion": 3,
        "basePath": "/api"
    },
    "routes": {
        "routesDir": "src/routes",
        "basePath": "/api"
    }
}
