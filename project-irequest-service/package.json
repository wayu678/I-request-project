  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run tsoa:gen && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run tsoa:gen && tsc",
    "start": "node dist/server.js",
    "watch": "nodemon dist/server.js",
